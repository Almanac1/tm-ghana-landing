# Copy the needed values into the existing ignored .env. Never commit credentials.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=sender@example.com
EMAIL_HOST_PASSWORD=replace-with-secret
DEFAULT_FROM_EMAIL=sender@example.com
LANDING_ADMIN_EMAIL=admin@example.com
# Staging verification instead of SMTP:
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=/absolute/writable/path/tm-test-emails
# Production: use a persistent shared database accessible to web, worker and Beat.
# USE_POSTGRES=True
# DB_NAME=tm_nigeria
# DB_USER=tm_nigeria
# DB_PASSWORD=replace-with-secret
# DB_HOST=your-database-host
# DB_PORT=5432
